{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mfj-ie-mailerlite-proxy",
  "main": "worker/site-worker.js",
  "compatibility_date": "2025-09-27",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": ".",
    "binding": "ASSETS"
  },
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "vars": {
    "TIKTOK_PIXEL_ID": "D9L843RC77U57S87KRC0"
  }
}
